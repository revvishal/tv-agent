# Copy this file to .env and fill in real values. Never commit the real .env.

# Base URL of your REST API (no trailing slash)
API_BASE_URL=https://trading-aggregator-server.vercel.app

# Bearer token sent as: Authorization: Bearer <JWT_TOKEN> (Service Actual Don't Need, Still kept for future.)
JWT_TOKEN=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJ1c2VybmFtZSI6ImFkbWluIiwiaWF0IjoxNzg4NDMzNjQ1LCJleHAiOjE3ODg1MjAwNDV9.SU-jMt1j-SCq8HEqR7hUeBIcUESQW2U1WvK7BA8FvL0

# Optional. Seconds to wait between processing each company (politeness delay
# to reduce the chance of being rate-limited / blocked by TradingView).
REQUEST_DELAY_SECONDS=15

# Optional. Set to "1" to run Playwright with a visible browser window instead
# of headless. Useful for local debugging only - not for the container.
PLAYWRIGHT_HEADED=0

# Optional. Set to "1" to save a screenshot + HTML dump of every page the
# scraper visits into ./debug/. Useful when TradingView changes its layout
# and you need to fix selectors.
SCRAPER_DEBUG=0
